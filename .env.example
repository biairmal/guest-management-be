# Copy to .env and adjust as needed.
# Used when running the app or migrations against Docker Compose services.

# PostgreSQL (matches docker-compose postgres service)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/guest_management?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DATABASE=guest_management
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Redis (matches docker-compose redis service; username: default, default password: redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis
REDIS_DB=0

# Swagger
SWAGGER_ENABLED=true
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=supersecret

# Tracing (matches docker-compose tempo service; OTLP/gRPC receiver)
TRACING_ENABLED=false
TRACING_ENDPOINT=localhost:4317
TRACING_INSECURE=true
TRACING_SAMPLE_RATE=1.0

# Metrics (Prometheus scrape endpoint at /metrics)
METRICS_ENABLED=true

# Rate limiting (in-memory token bucket by default; set RATELIMIT_BACKEND=redis to share state)
RATELIMIT_ENABLED=true
RATELIMIT_BACKEND=memory
RATELIMIT_RATE=10
RATELIMIT_BURST=20
RATELIMIT_WINDOW=1s
RATELIMIT_MAX_KEYS=10000

# Logging: set to "file" (writes JSON to ./logs/app.log) so docker-compose's
# promtail service can tail and ship it to Loki. Leave "stdout" for plain console logs.
LOG_OUTPUT=stdout

# Auth (JWT, HS256). hs256_secret has no safe default — every environment
# must set its own. access/refresh TTLs control the login token pair.
AUTH_HS256_SECRET=change-me-to-a-long-random-secret
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
AUTH_CACHE_TTL=0s

# PII field encryption (guests.email/phone — see go-sdk/lib/crypto). Both
# values below are syntactically valid, standard-base64-encoded 32-byte keys
# (so a fresh clone can `make run` out of the box) but are NOT secret —
# generate your own per environment (32 random bytes, base64-encoded) and
# never commit real ones. The two values must be distinct.
GUEST_PII_ENCRYPTION_KEY=FYHTkK1KB6PZobhoTlRZPREZ88HA0OQC2o1uICA5QAs=
GUEST_PII_BLIND_INDEX_KEY=FKtHakUcEvEIydDOYGC1na8idgDaeSLHwUa1SyUQ3Cs=